{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build SeederTerminal Desktop",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/SeederTerminal/SeederTerminal.Desktop/SeederTerminal.Desktop.csproj",
        "--configuration",
        "Debug",
        "-m:1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    }
  ]
}
